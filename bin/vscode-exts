#!/usr/bin/env python3
"""Run vscode-exts from either its checkout or an installed symlink."""

from __future__ import annotations

import sys
from pathlib import Path


# The installer exposes this file through a symlink instead of copying it. Resolve
# that link before locating the provider-private library so every checkout update
# changes the CLI and implementation atomically, with no second Python package to
# drift or shadow an unrelated site installation.
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from vscode_exts.reconciler import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
