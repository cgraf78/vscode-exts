#!/usr/bin/env bash
# install-test — checkout-backed installation and overwrite safety.

set -u

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$TEST_DIR/.." && pwd)

# shellcheck source=test/lib/test.sh
. "$TEST_DIR/lib/test.sh"

installer_wrapper="$ROOT/install.sh"
installer_delegate="$ROOT/support/install-checkout.sh"
_assert_file_exists "installation: generated checkout wrapper is present" \
  "$installer_wrapper"
_assert_file_exists "installation: checkout-owned delegate is present" \
  "$installer_delegate"
_assert_eq "installation: wrapper identifies the shared generator" \
  "# Generated by cgraf78/actions checkout-installer. Do not edit." \
  "$(sed -n '2p' "$installer_wrapper")"

prefix=$(_tmpdir)
unset install_rc
PREFIX="$prefix" "$installer_wrapper" \
  >"$prefix/install.out" 2>"$prefix/install.err" ||
  install_rc=$?
_assert_exit "installation: succeeds" 0 "${install_rc:-0}"

installed="$prefix/bin/vscode-exts"
if [[ -L "$installed" ]]; then
  _pass "installation: publishes a symlink"
else
  _fail "installation: publishes a symlink"
fi
_assert_eq "installation: symlink selects this checkout" \
  "$ROOT/bin/vscode-exts" "$(readlink "$installed")"
unset installed_rc
"$installed" --help >/dev/null 2>&1 || installed_rc=$?
_assert_exit "installation: symlink resolves the provider library" \
  0 "${installed_rc:-0}"

curl_source=$(_tmpdir)
curl_remote=$(_tmpdir)/vscode-exts.git
curl_checkout_parent=$(_tmpdir)
curl_checkout=$(cd -P -- "$curl_checkout_parent" && pwd -P)/vscode-exts
curl_prefix=$(_tmpdir)
cp "$installer_wrapper" "$curl_source/install.sh"
cp -R "$ROOT/bin" "$ROOT/lib" "$ROOT/share" "$ROOT/support" \
  "$curl_source/"
git -C "$curl_source" init --quiet --initial-branch=main --template=''
git -C "$curl_source" config core.hooksPath /dev/null
git -C "$curl_source" config commit.gpgsign false
git -C "$curl_source" config user.name 'vscode-exts installer test'
git -C "$curl_source" config user.email vscode-exts-installer@example.invalid
git -C "$curl_source" add .
git -C "$curl_source" commit --quiet -m 'curl installer fixture'
git init --quiet --bare --initial-branch=main "$curl_remote"
git -C "$curl_source" remote add origin "$curl_remote"
git -C "$curl_source" push --quiet --set-upstream origin main
curl_output=$(_tmpdir)/curl.out
curl --fail --silent --show-error "file://$installer_wrapper" |
  PREFIX="$curl_prefix" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$curl_checkout" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$curl_remote" \
    bash -s >"$curl_output" 2>&1
curl_pipeline_status=("${PIPESTATUS[@]}")
_assert_exit "installation: curl transport succeeds" \
  0 "${curl_pipeline_status[0]}"
_assert_exit "installation: managed checkout succeeds" \
  0 "${curl_pipeline_status[1]}"
_assert_file_exists "installation: curl bootstrap keeps a durable checkout" \
  "$curl_checkout/.git/HEAD"
curl_installed="$curl_prefix/bin/vscode-exts"
_assert_eq "installation: curl symlink selects the managed checkout" \
  "$curl_checkout/bin/vscode-exts" "$(readlink "$curl_installed")"
unset curl_runtime_rc
"$curl_installed" --help >/dev/null 2>&1 || curl_runtime_rc=$?
_assert_exit "installation: curl symlink resolves the private Python library" \
  0 "${curl_runtime_rc:-0}"
curl_manifest=$(_tmpdir)/invalid.toml
printf 'this is not valid TOML = [\n' >"$curl_manifest"
unset curl_manifest_rc
"$curl_installed" --manifest "$curl_manifest" \
  >"$curl_prefix/manifest.out" 2>"$curl_prefix/manifest.err" ||
  curl_manifest_rc=$?
_assert_exit "installation: curl command executes private manifest parsing" \
  2 "${curl_manifest_rc:-0}"
_assert_contains "installation: curl manifest error remains actionable" \
  "invalid TOML" "$(cat "$curl_prefix/manifest.err")"
curl_schema="$curl_checkout/share/vscode-exts/schemas/extensions.schema.json"
python3 - "$curl_schema" <<'PY'
import json
import sys
from pathlib import Path

schema = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert schema["$schema"] == "https://json-schema.org/draft/2020-12/schema"
assert schema["$id"].startswith(
    "https://raw.githubusercontent.com/cgraf78/vscode-exts/"
)
PY
_assert_exit "installation: curl checkout preserves the provider schema" 0 "$?"

unset reinstall_rc
PREFIX="$prefix" "$installer_wrapper" \
  >"$prefix/reinstall.out" 2>"$prefix/reinstall.err" || reinstall_rc=$?
_assert_exit "installation: reinstall is idempotent" 0 "${reinstall_rc:-0}"
_assert_eq "installation: reinstall preserves the checkout target" \
  "$ROOT/bin/vscode-exts" "$(readlink "$installed")"

custom_bin=$(_tmpdir)/commands
unset custom_rc
BIN_DIR="$custom_bin" "$installer_delegate" \
  >"$prefix/custom.out" 2>"$prefix/custom.err" || custom_rc=$?
_assert_exit "installation: custom BIN_DIR succeeds" 0 "${custom_rc:-0}"
_assert_eq "installation: custom BIN_DIR receives the checkout link" \
  "$ROOT/bin/vscode-exts" "$(readlink "$custom_bin/vscode-exts")"

blocked_prefix=$(_tmpdir)
mkdir -p "$blocked_prefix/bin"
printf 'user owned\n' >"$blocked_prefix/bin/vscode-exts"
unset blocked_rc
PREFIX="$blocked_prefix" "$installer_delegate" \
  >"$blocked_prefix/install.out" 2>"$blocked_prefix/install.err" || blocked_rc=$?
_assert_exit "installation: rejects a non-symlink destination" 1 "${blocked_rc:-0}"
_assert_eq "installation: preserves a non-symlink destination" \
  "user owned" "$(cat "$blocked_prefix/bin/vscode-exts")"
_assert_contains "installation: refusal names the destination" \
  "$blocked_prefix/bin/vscode-exts" "$(cat "$blocked_prefix/install.err")"

missing_root=$(_tmpdir)
missing_prefix=$(_tmpdir)
mkdir -p "$missing_root/support"
cp "$installer_delegate" "$missing_root/support/install-checkout.sh"
unset missing_rc
PREFIX="$missing_prefix" "$missing_root/support/install-checkout.sh" \
  >"$missing_prefix/install.out" 2>"$missing_prefix/install.err" || missing_rc=$?
_assert_exit "installation: missing command source fails" 1 "${missing_rc:-0}"
if [[ ! -e "$missing_prefix/bin/vscode-exts" &&
  ! -L "$missing_prefix/bin/vscode-exts" ]]; then
  _pass "installation: missing source publishes no command"
else
  _fail "installation: missing source publishes no command"
fi
_assert_contains "installation: missing source is actionable" \
  "command source is not executable" "$(cat "$missing_prefix/install.err")"

_test_summary
