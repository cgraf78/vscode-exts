_make_fake_cmd() {
  local path="$1"
  mkdir -p "$(dirname "$path")"
  cat >"$path" <<'PY'
#!/usr/bin/env python3
import os
import json
import re
import shlex
import subprocess
import sys
from pathlib import Path

args = sys.argv[1:]
try:
    command_index = args.index("/C")
    command = args[command_index + 1]
except (ValueError, IndexError):
    sys.exit(2)

log = os.environ.get("DOT_TEST_WINDOWS_CMD_LOG")
if log:
    with Path(log).open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps({
                "argv": args,
                "cwd": os.getcwd(),
            })
            + "\n"
        )

if "/D" not in args[:command_index]:
    print("missing /D", file=sys.stderr)
    sys.exit(3)

if command == "exit 0":
    sys.exit(0)

if command.startswith("set "):
    name = command.split(maxsplit=1)[1]
    value = os.environ.get(f"DOT_TEST_FAKE_{name}")
    if value:
        print(f"{name}={value}")
        sys.exit(0)
    sys.exit(1)

def to_posix(value):
    windows_home = os.environ.get("DOT_TEST_FAKE_USERPROFILE", "")
    posix_home = os.environ.get("DOT_TEST_FAKE_USERPROFILE_POSIX", "")
    if windows_home and posix_home and value.lower().startswith(windows_home.lower()):
        suffix = value[len(windows_home):].replace("\\", "/").lstrip("/")
        return str(Path(posix_home) / suffix) if suffix else posix_home
    return value

wrapper = Path(to_posix(command))
rest = [to_posix(arg) for arg in args[command_index + 2:]]
lines = [
    line.strip()
    for line in wrapper.read_text(encoding="utf-8").splitlines()
    if line.strip()
]
launch = next(
    line
    for line in lines
    if not line.lower().startswith("@echo")
    and not line.lower().startswith("set ")
)
quoted = re.findall(r'"([^"]+)"', launch.replace("%*", ""))
base = [to_posix(item) for item in quoted] or shlex.split(launch.replace("%*", ""))
env = os.environ.copy()
env["ELECTRON_RUN_AS_NODE"] = "1"
result = subprocess.run([*base, *rest], env=env, check=False)
sys.exit(result.returncode)
PY
  chmod +x "$path"
}

