#!/usr/bin/env bash
# vscode-extensions-test — VS Code extension manifest and resolver behavior.

set -euo pipefail
export NO_COLOR=1

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$TEST_DIR/.." && pwd)

# shellcheck source=test/lib/test.sh
. "$TEST_DIR/lib/test.sh"

if ! command -v python3 >/dev/null 2>&1; then
  echo "SKIP: vscode-extensions-test (python3 unavailable)"
  exit 0
fi

helper="$ROOT/bin/vscode-exts"
module="$ROOT/lib/vscode_exts/reconciler.py"
if [[ ! -f "$helper" ]]; then
  _fail "vscode extensions: helper exists"
  _test_summary
fi

_make_fake_code() {
  local path="$1" fail_list="${2:-0}" sleep_seconds="${3:-0}"
  mkdir -p "$(dirname "$path")"
  cat >"$path" <<'PY'
#!/usr/bin/env python3
import json
import os
import sys
import time
from pathlib import Path

args = sys.argv[1:]
log = Path(os.environ["DOT_TEST_VSCODE_EXT_LOG"])
fail_list = "__FAIL_LIST__" == "1"
sleep_seconds = float("__SLEEP_SECONDS__")

def value_after(flag):
    try:
        return args[args.index(flag) + 1]
    except (ValueError, IndexError):
        return ""

extensions_dir = Path(value_after("--extensions-dir"))
state_path = extensions_dir / "installed.json"
extensions_dir.mkdir(parents=True, exist_ok=True)
if state_path.exists():
    installed = json.loads(state_path.read_text(encoding="utf-8"))
else:
    installed = {}

with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps({
        "command": sys.argv[0],
        "argv": args,
        "electron_run_as_node": os.environ.get("ELECTRON_RUN_AS_NODE"),
    }) + "\n")

if sleep_seconds > 0:
    time.sleep(sleep_seconds)

if "--list-extensions" in args:
    if fail_list:
        print("list failed", file=sys.stderr)
        sys.exit(3)
    for extension_id, version in sorted(installed.items()):
        if version:
            print(f"{extension_id}@{version}")
        else:
            print(extension_id)
    sys.exit(0)

if "--install-extension" in args:
    spec = value_after("--install-extension")
    if "@" in spec:
        extension_id, version = spec.rsplit("@", 1)
    else:
        extension_id, version = spec, None
    installed[extension_id.lower()] = version
    state_path.write_text(json.dumps(installed, sort_keys=True), encoding="utf-8")
    sys.exit(0)

sys.exit(0)
PY
  perl -0pi -e "s/__FAIL_LIST__/$fail_list/g" "$path"
  perl -0pi -e "s/__SLEEP_SECONDS__/$sleep_seconds/g" "$path"
  chmod +x "$path"
}

