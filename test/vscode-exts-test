import importlib.util
import os
import sys
from pathlib import Path

helper = Path(sys.argv[1])
work = Path(sys.argv[2])
spec = importlib.util.spec_from_file_location("dot_vscode_extensions", helper)
assert spec is not None and spec.loader is not None
module = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = module
spec.loader.exec_module(module)

home = work / "lock-home"
target = work / "extensions"
absolute_cache = work / "absolute-cache"
assert module._xdg_cache_home(
    {"HOME": str(home), "XDG_CACHE_HOME": str(absolute_cache)}
) == absolute_cache
assert module._xdg_cache_home({"HOME": str(home), "XDG_CACHE_HOME": ""}) == home / ".cache"
assert module._xdg_cache_home(
    {"HOME": str(home), "XDG_CACHE_HOME": "relative/cache"}
) == home / ".cache"
assert module._xdg_cache_home({"XDG_CACHE_HOME": str(absolute_cache)}) == absolute_cache
assert module._xdg_cache_home({"XDG_CACHE_HOME": "relative/cache"}) is None

newline_cache = Path(f"{absolute_cache}\n")
assert os.fsencode(module._xdg_cache_home({"XDG_CACHE_HOME": str(newline_cache)})) == os.fsencode(
    newline_cache
)

cwd_one = work / "lock-cwd-one"
cwd_two = work / "lock-cwd-two"
cwd_one.mkdir()
cwd_two.mkdir()
env = {"HOME": str(home), "XDG_CACHE_HOME": "relative/cache"}
os.chdir(cwd_one)
lock_one = module._extension_lock_path(target, env)
os.chdir(cwd_two)
lock_two = module._extension_lock_path(target, env)
assert lock_one == lock_two
assert lock_one is not None and lock_one.parent == home / ".cache/dot/vscode-extensions"
